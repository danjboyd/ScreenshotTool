From: Daniel Boyd <danieljboyd@icloud.com>
Subject: cairo: a freed surface isn't left as its window's gdriver

The difference between 0004 v3 (252f0b8) and v4 (9f8f53f) in the Adwaita libs-back series, without its
test. libs-gui can free the surface before -termwindow:, whose windowWillTerminate call then messaged
a freed object and destroyed its window surface a second time.

diff --git a/Headers/cairo/XGCairoModernSurface.h b/Headers/cairo/XGCairoModernSurface.h
index 02c03b6..ddb5330 100644
--- a/Headers/cairo/XGCairoModernSurface.h
+++ b/Headers/cairo/XGCairoModernSurface.h
@@ -34,6 +34,10 @@
     /* The shadow round the window, for its margin and rounded corners
        (gswindow_device_t shadow); NULL without a margin. */
     cairo_surface_t *_shadowSurface;
+    /* YES while the window device names this surface as its gdriver and
+       the window is there: the window's -termwindow: and a newer surface
+       for the same window clear it. */
+    BOOL _isDriver;
 }
 @end
 
diff --git a/Source/cairo/XGCairoModernSurface.m b/Source/cairo/XGCairoModernSurface.m
index 3494073..b9870da 100644
--- a/Source/cairo/XGCairoModernSurface.m
+++ b/Source/cairo/XGCairoModernSurface.m
@@ -297,7 +297,15 @@ create_shadow(cairo_surface_t *similar, int width, int height,
       // Ask XGServerWindow to call +[CairoContext handleExposeRect:forDriver:]
       // to let us handle the back buffer -> front buffer copy using cairo.
       GSWINDEVICE->gdriverProtocol |= GDriverHandlesExpose | GDriverHandlesBacking;
+      /* A surface the window had before (the window changed size, say) may
+	 outlive the window: it no longer touches the window device. */
+      if (GSWINDEVICE->gdriver != NULL && GSWINDEVICE->gdriver != self
+	&& [(id)GSWINDEVICE->gdriver isKindOfClass: [XGCairoModernSurface class]])
+	{
+	  ((XGCairoModernSurface *)GSWINDEVICE->gdriver)->_isDriver = NO;
+	}
       GSWINDEVICE->gdriver = self;
+      _isDriver = YES;
 
       _windowSurface = windowsurface;
       _surface = cairo_surface_create_similar(windowsurface,
@@ -333,6 +341,8 @@ create_shadow(cairo_surface_t *similar, int width, int height,
  * buffer and the shadow are pixmaps of their own and can wait. */
 - (void) windowWillTerminate
 {
+  /* The window device goes with the window. */
+  _isDriver = NO;
   if (_windowSurface != NULL)
     {
       cairo_surface_destroy(_windowSurface);
@@ -342,6 +352,15 @@ create_shadow(cairo_surface_t *similar, int width, int height,
 
 - (void) dealloc
 {
+  /* The window holds the gdriver without retaining it, and -termwindow:
+     sends it -windowWillTerminate.  The gui lets go of the window's
+     graphics state, and so of this surface, before it terminates the
+     window, so a surface nothing else holds is freed first: then the
+     window must not name it. */
+  if (_isDriver && GSWINDEVICE->gdriver == self)
+    {
+      GSWINDEVICE->gdriver = NULL;
+    }
   if (_windowSurface != NULL)
     {
       cairo_surface_destroy(_windowSurface);
