{
  "schemaVersion": 1,
  "profiles": [
    "gnustep-gui"
  ],
  "package": {
    "id": "com.danboyd.screenshottool",
    "name": "ScreenshotTool",
    "displayName": "ScreenshotTool",
    "version": "0.1.2",
    "manufacturer": "Daniel Boyd",
    "summary": "Annotate screenshots and other images with pen, highlighter, and text tools.",
    "description": "ScreenshotTool is a GNUstep desktop app for opening screenshots and other images, marking them up with pen, highlighter, eraser, and text tools, then saving or copying the annotated result.",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/danjboyd/ScreenshotTool"
  },
  "pipeline": {
    "workingDirectory": "..",
    "shell": {
      "kind": "pwsh",
      "bootstrapCommands": [],
      "environment": {}
    },
    "build": {
      "command": "./scripts/build_release.ps1 -ManifestPath packaging/package.manifest.json -PackageVersion $env:GP_PACKAGE_VERSION"
    },
    "stage": {
      "command": "./scripts/stage_release.ps1 -ManifestPath packaging/package.manifest.json -StageRoot dist/stage -PackageVersion $env:GP_PACKAGE_VERSION",
      "outputRoot": "../dist/stage"
    }
  },
  "payload": {
    "layoutVersion": 1,
    "stageRoot": "../dist/stage",
    "appRoot": "app",
    "runtimeRoot": "runtime",
    "metadataRoot": "metadata",
    "runtimeSeedPaths": [
      "runtime/bin/defaults",
      "runtime/bin/defaults.exe"
    ]
  },
  "launch": {
    "entryRelativePath": "app/ScreenshotTool.app/ScreenshotTool",
    "workingDirectory": "app/ScreenshotTool.app",
    "arguments": [],
    "pathPrepend": [
      "runtime/bin"
    ],
    "env": {
      "GNUSTEP_PATHPREFIX_LIST": "{@runtimeRoot}",
      "GNUSTEP_SYSTEM_ROOT": "{@runtimeRoot}/System",
      "GNUSTEP_LOCAL_ROOT": "{@runtimeRoot}/System",
      "GNUSTEP_NETWORK_ROOT": "{@runtimeRoot}/System",
      "LD_LIBRARY_PATH": "{@runtimeRoot}/lib:{@runtimeRoot}/System/Library/Libraries"
    }
  },
  "platformOverrides": {
    "windows": {
      "launch": {
        "entryRelativePath": "app/ScreenshotTool.app/ScreenshotTool.exe"
      }
    }
  },
  "themeInputs": [
    {
      "name": "WinUITheme",
      "repo": "https://github.com/danjboyd/plugins-themes-winuitheme.git",
      "ref": "f2aaa603eafe536958f14f976aadd6698a53ac2b",
      "platforms": [
        "msi"
      ],
      "required": true,
      "default": true
    },
    {
      "name": "WinUXTheme",
      "repo": "https://github.com/gnustep/plugins-themes-WinUXTheme.git",
      "ref": "92ab1fb034ce8b8be82441730d4b843eda708b6e",
      "platforms": [
        "msi"
      ],
      "required": true
    }
  ],
  "packagedDefaults": {
    "defaultTheme": "WinUITheme"
  },
  "outputs": {
    "root": "../dist",
    "packageRoot": "../dist/packages",
    "logRoot": "../dist/logs",
    "tempRoot": "../dist/tmp",
    "validationRoot": "../dist/validation"
  },
  "validation": {
    "smoke": {
      "enabled": true,
      "kind": "staged-layout",
      "requiredPaths": [
        "metadata/icons/ScreenshotToolIcon.png",
        "metadata/licenses/ScreenshotTool.txt",
        "metadata/licenses/gnustep-runtime.txt",
        "runtime/bin"
      ],
      "timeoutSeconds": 30
    },
    "logs": {
      "retainOnSuccess": true
    }
  },
  "updates": {
    "enabled": true,
    "provider": "github-release-feed",
    "channel": "stable",
    "minimumCheckIntervalHours": 24,
    "startupDelaySeconds": 15,
    "github": {
      "owner": "danjboyd",
      "repo": "ScreenshotTool",
      "tagPattern": "v{version}",
      "releaseNotesUrlPattern": "https://github.com/{owner}/{repo}/releases/tag/{tag}"
    }
  },
  "integrations": {
    "shortcutName": "ScreenshotTool",
    "categories": [
      "Graphics",
      "Utility"
    ],
    "fileAssociations": [
      {
        "kind": "extension",
        "value": ".png",
        "description": "PNG image"
      },
      {
        "kind": "extension",
        "value": ".jpg",
        "description": "JPEG image"
      },
      {
        "kind": "extension",
        "value": ".jpeg",
        "description": "JPEG image"
      },
      {
        "kind": "extension",
        "value": ".gif",
        "description": "GIF image"
      },
      {
        "kind": "extension",
        "value": ".bmp",
        "description": "Bitmap image"
      },
      {
        "kind": "extension",
        "value": ".tif",
        "description": "TIFF image"
      },
      {
        "kind": "extension",
        "value": ".tiff",
        "description": "TIFF image"
      },
      {
        "kind": "extension",
        "value": ".webp",
        "description": "WebP image"
      }
    ]
  },
  "compliance": {
    "runtimeNotices": [
      {
        "name": "ScreenshotTool",
        "version": "0.1.2",
        "license": "GPL-2.0-or-later",
        "source": "ScreenshotTool application bundle",
        "homepage": "https://github.com/danjboyd/ScreenshotTool",
        "stageRelativePath": "metadata/licenses/ScreenshotTool.txt"
      },
      {
        "name": "GNUstep Runtime",
        "license": "LGPL-2.1-or-later",
        "source": "Bundled GNUstep base/gui/back runtime payload",
        "homepage": "https://gnustep.org/",
        "stageRelativePath": "metadata/licenses/gnustep-runtime.txt"
      },
      {
        "name": "GNUstep tools",
        "license": "GPL-3.0-or-later AND GPL-2.0-or-later",
        "source": "GNUstep command-line tools (defaults, gdnc, gpbs, make_services, ...)",
        "homepage": "https://gnustep.org/",
        "stageRelativePath": "metadata/licenses/gnustep-tools.txt"
      },
      {
        "name": "WinUITheme",
        "version": "0.1.0-alpha3",
        "license": "LGPL-2.1-or-later",
        "source": "Default Windows theme, from danjboyd/plugins-themes-winuitheme",
        "homepage": "https://github.com/danjboyd/plugins-themes-winuitheme",
        "stageRelativePath": "metadata/licenses/WinUITheme.txt"
      },
      {
        "name": "WinUXTheme",
        "version": "92ab1fb",
        "license": "LGPL-2.0-or-later",
        "source": "Windows theme, from gnustep/plugins-themes-WinUXTheme",
        "homepage": "https://github.com/gnustep/plugins-themes-WinUXTheme",
        "stageRelativePath": "metadata/licenses/WinUXTheme.txt"
      }
    ]
  },
  "backends": {
    "msi": {
      "enabled": true,
      "upgradeCode": "202a62ea-703b-467d-a58f-5865640fdca9",
      "installScope": "perUser",
      "productName": "ScreenshotTool",
      "shortcutName": "ScreenshotTool",
      "installDirectoryName": "ScreenshotTool",
      "launcherFileName": "ScreenshotTool.exe",
      "iconRelativePath": "metadata/icons/ScreenshotTool.ico",
      "ignoredRuntimeDependencies": [
        "dbghelp.dll",
        "DNSAPI.dll",
        "DWrite.dll",
        "IPHLPAPI.DLL",
        "MSIMG32.dll",
        "OPENGL32.dll",
        "PSAPI.DLL",
        "USP10.dll",
        "WINSPOOL.DRV"
      ],
      "signing": {
        "enabled": false,
        "timestampUrl": "http://timestamp.digicert.com",
        "description": "ScreenshotTool installer"
      },
      "updates": {
        "feedUrl": "https://danjboyd.github.io/ScreenshotTool/updates/windows/stable.json"
      }
    },
    "appimage": {
      "enabled": true,
      "desktopEntryName": "io.github.danjboyd.ScreenshotTool.desktop",
      "iconRelativePath": "metadata/icons/ScreenshotToolIcon.png",
      "gnustepConfig": {
        "systemRoot": "runtime/System",
        "globalDefaults": {
          "GSFirstCommandKey": "Control_L",
          "GSSecondCommandKey": "Control_R",
          "GSFirstControlKey": "Alt_L",
          "GSSecondControlKey": "Alt_R",
          "GSFirstAlternateKey": "Super_L",
          "GSSecondAlternateKey": "Super_R",
          "NSMenuInterfaceStyle": "NSWindows95InterfaceStyle",
          "GnomeThemeMenuStyle": "primary",
          "GSSuppressAppIcon": true
        },
        "defaultTheme": {
          "name": "Adwaita",
          "desktops": [
            "GNOME"
          ],
          "defaults": {
            "GSX11HandlesWindowDecorations": false
          }
        }
      },
      "fonts": {
        "bundle": [
          {
            "name": "DejaVu Sans",
            "files": [
              "fonts/dejavu/DejaVuSans.ttf",
              "fonts/dejavu/DejaVuSans-Bold.ttf",
              "fonts/dejavu/DejaVuSansMono.ttf",
              "fonts/dejavu/DejaVuSansMono-Bold.ttf"
            ],
            "licenseFile": "fonts/dejavu/LICENSE",
            "license": "Bitstream-Vera AND LicenseRef-Arev-Fonts",
            "homepage": "https://dejavu-fonts.github.io/"
          }
        ]
      },
      "updates": {
        "feedUrl": "https://danjboyd.github.io/ScreenshotTool/updates/linux/stable.json",
        "embedUpdateInformation": true,
        "releaseSelector": "latest"
      },
      "smoke": {
        "mode": "launch-only"
      }
    }
  }
}
