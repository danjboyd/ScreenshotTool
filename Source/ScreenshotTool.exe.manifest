<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- ScreenshotTool.exe's application manifest (Windows only; ScreenshotTool.rc embeds it). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- System DPI-aware: GNUstep scales the UI by the display's DPI (NSScreen's
       userSpaceScaleFactor, from the backend's resolutionForScreen:), so text and
       controls are drawn at the display's resolution instead of being stretched by
       Windows. The backend reads one DPI for all monitors, so the app can't be
       per-monitor aware yet: on a monitor scaled differently from the primary,
       Windows still stretches it. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">system</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
